# ============================================================
# SCOUTE — Environment Variables
# Copy this file to .env and fill in your credentials.
# Never commit .env to version control.
# ============================================================

# --- Anthropic (Ghostwriter Agent) ---
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# --- Reddit API (Scout Agent) ---
# Create an app at https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=scoute-bot/1.0 by u/your_reddit_username

# --- Twitter/X API v2 (Scout Agent) ---
# Create a project at https://developer.twitter.com
TWITTER_BEARER_TOKEN=your_twitter_bearer_token
TWITTER_API_KEY=your_twitter_api_key
TWITTER_API_SECRET=your_twitter_api_secret
TWITTER_ACCESS_TOKEN=your_twitter_access_token
TWITTER_ACCESS_SECRET=your_twitter_access_secret

# --- Spotify API (Arbitrage Agent) ---
# Create an app at https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret

# --- JSONbin.io (cloud data sync) ---
# Sign up free at https://jsonbin.io → API Keys → copy Master Key
# Bin IDs are stored automatically in .jsonbin_ids.json on first pipeline run.
# Commit .jsonbin_ids.json so Railway can find the same bins.
JSONBIN_KEY=your_jsonbin_master_key
